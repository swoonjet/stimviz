# Python build/cache
__pycache__/
*.pyc
*.pyo

# Agent runtime artifacts
agent/.running
agent/agent.log
agent/launchd-out.log
agent/launchd-err.log
agent/audit-report.json

# Link-check caches — large, regeneratable, and machine-specific timings.
