# learned inputs (how each host answers, which roots were confirmed), not caches.
agent/verify-cache.json
agent/ancestor-cache.json
agent/cdx-cache.json
agent/reanchor-report.json
agent/retarget-report.json

# Local backups (regeneratable)
discoveries.before-cleanup.json
discoveries.before-reanchor.json
*.bak

.DS_Store
